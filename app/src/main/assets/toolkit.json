  "guides": [
    {
      "id": "bank-app-unsafe",
      "tag": "ROOT",
      "title": "銀行、薪資轉帳 App 顯示「裝置不安全」",
      "summary": "多數金融類 App 會偵測裝置是否 Root。交機時已安裝隱藏套件因應，交付後若又出現，通常是 App 更新了偵測機制。",
      "steps": [
        {
          "t": "完整重開機",
          "d": "先把手機重新啟動一次，不要只是關閉 App 再開。"
        },
        {
          "t": "再開一次 App",
          "d": "重開機後再次開啟該金融 App，確認是否恢復正常。"
        },
        {
          "t": "仍無效就聯絡我們",
          "d": "透過 Threads 聯絡我們，附上 App 名稱與畫面截圖。"
        }
      ]
    },
    {
      "id": "root-gone-after-ota",
      "tag": "ROOT",
      "title": "系統自動更新後，Root 不見了",
      "summary": "系統 OTA 更新通常會清除 Root，這是正常現象，不是壞掉。",
      "steps": [
        {
          "t": "先關閉自動更新",
          "d": "到手機「設定」內關閉系統自動更新，避免再次被覆蓋。"
        },
        {
          "t": "需要重新刷入",
          "d": "透過 Threads 聯絡我們，我們會協助重新刷入。"
        }
      ]
    },
